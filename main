local function espSnap(parent)
    local t = {}
    for _, ch in ipairs(parent:GetChildren()) do t[ch] = true end
    return t
end
local function espNew(parent, before)
    local out = {}
    for _, ch in ipairs(parent:GetChildren()) do
        if not before[ch] then table.insert(out, ch) end
    end
    return out
end
local function espVis(list, v)
    task.defer(function()
        for _, f in ipairs(list) do pcall(function() f.Visible = v end) end
    end)
end

