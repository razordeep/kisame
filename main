AutofarmTab:Button({ Name="Check input methods", Callback=function()
    local lines = {}
    table.insert(lines, "VIM: " .. (VIM and "YES" or "NO"))
    table.insert(lines, "mouse1press: " .. (type(rawget(_G,"mouse1press"))=="function" and "YES" or "NO"))
    table.insert(lines, "mouse2press: " .. (type(rawget(_G,"mouse2press"))=="function" and "YES" or "NO"))
    table.insert(lines, "mousemoverel: " .. (type(rawget(_G,"mousemoverel"))=="function" and "YES" or "NO"))
    table.insert(lines, "keypress: " .. (type(rawget(_G,"keypress"))=="function" and "YES" or "NO"))
    local msg = table.concat(lines, "  |  ")
    Window:Notify("Input Methods", msg, 10)
    warn("[Kisame AF Debug] " .. msg)
end })
AutofarmTab:Button({ Name="Sniff: ADS + shoot, show remotes", Callback=function()
    if not hookmetamethod then
        Window:Notify("Sniff", "hookmetamethod not available.", 5)
        return
    end
    Window:Notify("Sniff", "ADS then shoot ONCE in the next 5 seconds. Check output after.", 5)
    Window.main.Visible = false

    local captured = {}
    local sniffing = true
    local oldNC
    local wrapFn = (newcclosure or function(f) return f end)
    oldNC = hookmetamethod(game, "__namecall", wrapFn(function(self, ...)
        if sniffing and typeof(self) == "Instance" then
            local m = getnamecallmethod()
            if m == "FireServer" or m == "InvokeServer" or m == "Fire" or m == "Invoke" then
                local args = {...}
                -- Encode args to readable string
                local parts = {}
                for _, a in ipairs(args) do
                    local t = typeof(a)
                    if t == "Instance"  then table.insert(parts, "Instance:" .. a.Name)
                    elseif t == "Vector3" then table.insert(parts, string.format("V3(%.1f,%.1f,%.1f)", a.X, a.Y, a.Z))
                    elseif t == "CFrame"  then table.insert(parts, string.format("CF(%.1f,%.1f,%.1f)", a.X, a.Y, a.Z))
                    elseif t == "boolean" then table.insert(parts, tostring(a))
                    elseif t == "number"  then table.insert(parts, tostring(math.floor(a*100)/100))
                    else table.insert(parts, t) end
                end
                table.insert(captured, {
                    remote = self.Name,
                    path   = self:GetFullName(),
                    method = m,
                    argStr = table.concat(parts, ", "),
                    tick   = tick(),
                })
            end
        end
        return oldNC(self, ...)
    end))

    task.delay(5, function()
        sniffing = false
        pcall(function() hookmetamethod(game, "__namecall", oldNC) end)
        Window.main.Visible = true

        if #captured == 0 then
            Window:Notify("Sniff result", "Nothing captured. Make sure you ADS + shot in the window.", 7)
            warn("[Kisame AF Sniff] No remotes captured.")
            return
        end

        warn("[Kisame AF Sniff] === " .. #captured .. " remote(s) captured ===")
        local seen = {}
        for i, c in ipairs(captured) do
            local key = c.path .. "|" .. c.method
            if not seen[key] then
                seen[key] = true
                local line = string.format("[%d] %s → %s  |  %s", i, c.method, c.remote, c.argStr)
                warn("[Kisame AF Sniff] " .. line)
                -- Show up to 3 notifications so they don't all stack off-screen
                if i <= 3 then
                    Window:Notify("Remote #"..i, c.method.." → "..c.remote.."  |  "..c.argStr, 15)
                end
            end
        end
        warn("[Kisame AF Sniff] Full paths:")
        for _, c in ipairs(captured) do
            warn("  " .. c.path)
        end
        Window:Notify("Sniff done", #captured .. " remote(s). Check executor output for full paths.", 8)
    end)
end })


local selectedWL = nil
local function getPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(names, p.Name) end
    end
    table.sort(names); return names
end
