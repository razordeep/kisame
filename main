    if processed then return end
    local mk = MENU_KEYS[Settings.MenuKeyName]
    if mk and input.KeyCode == mk then Window:ToggleVisible() end
    local uk = MENU_KEYS[Settings.UnexecuteKeyName]
    if uk and input.KeyCode == uk then Unexecute() end
end)

-- VIM moved to top of file (see line ~18)

local function tapKey(keyCode)
    -- keyCode is a KeyCode enum value; extract the integer for APIs that need it
    local kcVal = type(keyCode) == "number" and keyCode
                  or (keyCode and keyCode.Value) or 0

    -- Method 1: VirtualInputManager
    if VIM then
        local ok = pcall(function()
            VIM:SendKeyEvent(true,  kcVal, false, game)
            task.wait()
            VIM:SendKeyEvent(false, kcVal, false, game)
        end)
        if ok then return end
    end

    -- Method 2: keypress / keyrelease (older executors)
    local kp = rawget(_G, "keypress")
    local kr = rawget(_G, "keyrelease")
    if type(kp) == "function" and type(kr) == "function" then
        pcall(kp, kcVal)
        task.wait()
        pcall(kr, kcVal)
    end
end

local rollBusy = false
local function runRollMacro()
    if rollBusy then return end
    rollBusy = true
    task.spawn(function()
        pcall(function()
            local wkc = WEAPON_BIND_KEYS[Settings.RollWeaponBindName]
            tapKey(Enum.KeyCode.Space)
            task.wait(Settings.RollSpaceDelay / 1000)
            if wkc then
                tapKey(wkc)
                task.wait(Settings.RollRepeatDelay / 1000)
                tapKey(wkc)
            end
        end)
        rollBusy = false
    end)
end

local weaponSpamThread = nil
startWeaponSpam = function()
    if weaponSpamThread then return end
    weaponSpamThread = task.spawn(function()
        while Running and Settings.WeaponSpamMacro do
            local wkc = WEAPON_BIND_KEYS[Settings.WeaponSpamBindName]
            if wkc then pcall(function() tapKey(wkc) end) end
            task.wait(Settings.WeaponSpamDelay / 1000)
        end
        weaponSpamThread = nil
    end)
end
stopWeaponSpam = function()
    if weaponSpamThread then pcall(function() task.cancel(weaponSpamThread) end); weaponSpamThread=nil end
end

rebindRollMacro = function()
    pcall(function() ContextActionService:UnbindAction(ROLL_ACTION) end)
    local kc = ROLL_MACRO_KEYS[Settings.RollMacroKeyName]
    if not kc then return end
    pcall(function()
        ContextActionService:BindAction(ROLL_ACTION, function(_, state)
            if not Running or not Settings.RollMacro then return Enum.ContextActionResult.Pass end
            if state == Enum.UserInputState.Begin then runRollMacro() end
            return Enum.ContextActionResult.Sink
        end, false, kc)
    end)
end
rebindRollMacro()

rebindWeaponSpamTrigger = function()
    pcall(function() ContextActionService:UnbindAction(WEAPON_SPAM_TRIGGER_ACTION) end)
    local kc = WEAPON_BIND_KEYS[Settings.WeaponSpamTriggerKeyName]
    if not kc then return end
    pcall(function()
        ContextActionService:BindAction(WEAPON_SPAM_TRIGGER_ACTION, function(_, state)
            if not Running or not Settings.WeaponSpamMacro then return Enum.ContextActionResult.Pass end
            if state == Enum.UserInputState.Begin then startWeaponSpam()
            elseif state == Enum.UserInputState.End then stopWeaponSpam() end
            return Enum.ContextActionResult.Sink
        end, false, kc)
    end)
end
rebindWeaponSpamTrigger()

local AF_TOGGLE_ACTION = "Kisame_AutofarmToggle"
local afToggleConn = nil
rebindAutofarmToggle = function()
    -- Unbind old CAS bind
    pcall(function() ContextActionService:UnbindAction(AF_TOGGLE_ACTION) end)
    -- Disconnect old UIS bind
    if afToggleConn then pcall(function() afToggleConn:Disconnect() end); afToggleConn = nil end

    local kc = ROLL_MACRO_KEYS[Settings.AutoFarmToggleKeyName]
    if not kc then return end

    local function doToggle()
        local newVal = not Settings.AutoFarmEnabled
        -- Update the UI toggle so the slider reflects the real state
        local el = Window.Flags["AutoFarmEnabled"]
        if el then
            el:Set(newVal)  -- this fires the Callback which sets Settings and starts/stops
        else
            -- Fallback if Flags not ready yet
            Settings.AutoFarmEnabled = newVal
            if newVal then startAutofarm() else stopAutofarm() end
        end
        Window:Notify("Autofarm", newVal and "ON" or "OFF", 1)
    end

    -- Try standard BindAction first (works on all executors)
    local casOk = pcall(function()
        ContextActionService:BindAction(AF_TOGGLE_ACTION, function(_, state)
            if not Running then return Enum.ContextActionResult.Pass end
            if state == Enum.UserInputState.Begin then doToggle() end
            return Enum.ContextActionResult.Sink
        end, false, kc)
    end)

    -- Fallback: raw UserInputService connection (guaranteed to work)
    if not casOk then
        afToggleConn = conn(UserInputService.InputBegan, function(input, gp)
            if gp then return end
            if not Running then return end
            if input.KeyCode == kc then doToggle() end
        end)
    end
end
rebindAutofarmToggle()

local function hookCharacter(player, character)
    -- Clear stale visibility cache for the old character when a player respawns.
    -- Without this, the cached RaycastParams still reference the old character
    -- model (which no longer exists), causing isPlayerVisible to behave
    -- unpredictably for the respawned player.
    if character then
        _rayParamsCache[character] = nil
        _rayParamsSeat[character]  = nil
    end
    -- Also clear any old characters for this player that may still be cached
    for cachedChar in pairs(_rayParamsCache) do
        local ok, owner = pcall(function() return game:GetService("Players"):GetPlayerFromCharacter(cachedChar) end)
        if ok and owner == player then
            _rayParamsCache[cachedChar] = nil
            _rayParamsSeat[cachedChar]  = nil
        end
    end
    -- Re-create ESP object for the new character
    removeESP(player)
    createESP(player)
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        createESP(player)
        conn(player.CharacterAdded, function(char) hookCharacter(player, char) end)
    end
end
conn(Players.PlayerAdded, function(p)
    createESP(p)
    conn(p.CharacterAdded, function(char) hookCharacter(p, char) end)
    wlDropdown:Refresh(getPlayerNames())
end)
conn(Players.PlayerRemoving, function(p)
    removeESP(p)
    if lockedPlayer == p then lockedPlayer=nil end
    local ch = p.Character
    if ch then _rayParamsCache[ch]=nil; _rayParamsSeat[ch]=nil end
    wlDropdown:Refresh(getPlayerNames())
end)

task.spawn(function()
    task.wait(0.5)
    local missing={}
    if not HAS_DRAWING then table.insert(missing,"Drawing (no ESP)") end
    if not mousemoverel then table.insert(missing,"mousemoverel (no aim)") end
    if not hookmetamethod then table.insert(missing,"hookmetamethod (no silent aim)") end
    if not HAS_FS then table.insert(missing,"file functions (no configs)") end
    if #missing>0 then Window:Notify("Executor","Missing: "..table.concat(missing,", "),8) end
end)

task.spawn(function()
    -- Wait long enough for the UI to fully render and all Flags to register.
    -- 0.3s was too short on slower machines/executors — syncUI would fire
    -- before dropdowns finished their initial :Set() calls, silently erroring.
    task.wait(0.5)
    task.wait() -- extra frame yield for safety
    pcall(refreshCfgList)
    local okA, name = pcall(getAutoload)
    if not okA or not name then return end

    -- Ensure all current players have ESP objects before the config is applied,
    -- otherwise ESPEnabled=true from the config has nothing to draw.
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not ESPObjects[p] then
            pcall(createESP, p)
        end
    end

    -- Load the config (applyConfigData + syncUI inside loadConfig)
    local ok, a, b = pcall(loadConfig, name)
    if ok and a then
        -- Select the loaded config in the dropdown so it shows as active
        pcall(refreshCfgList, name)
        notify("Auto-loaded", '"'..name..'" applied.')
    else
        notify("Auto-load failed", tostring(ok and b or a), 4)
    end
end)

end, function(e) return tostring(e).."\n"..tostring(debug and debug.traceback and debug.traceback("",2) or "") end)

if not __ok then
    warn("[Kisame] STARTUP ERROR: "..tostring(__err))
    pcall(function()
        local g=Instance.new("ScreenGui")
        g.Name="KisameError"; g.ResetOnSpawn=false; g.DisplayOrder=10000
        local l=Instance.new("TextLabel")
        l.Size=UDim2.new(1,-40,0,220); l.Position=UDim2.fromOffset(20,20)
        l.BackgroundColor3=Color3.fromRGB(40,0,0); l.TextColor3=Color3.new(1,1,1)
        l.TextWrapped=true; l.TextSize=12; l.Font=Enum.Font.Gotham
        l.TextXAlignment=Enum.TextXAlignment.Left
        l.Text="[Kisame] startup error:\n"..tostring(__err)
        l.Parent=g
        local p=(gethui and gethui()) or game:GetService("CoreGui")
        g.Parent=p
        task.delay(30,function() g:Destroy() end)
    end)
end
