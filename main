end })

local HAS_FS = (writefile and readfile and isfile and isfolder and makefolder and listfiles and delfile) ~= nil
local CFG_FOLDER    = "Kisame_Configs"
local AUTOLOAD_FILE = CFG_FOLDER .. "/_autoload.txt"
local function cfgPath(n) return CFG_FOLDER.."/"..n..".json" end

local PERSIST_BOOL = {
    "ESPEnabled","ShowBox","ShowName","ShowHealth","ShowDistance","ShowSkeleton","AutoFarmEnabled",
    "AimEnabled","AimSmoothing","ShowFOVCircle","StickyAim",
    "VisibleCheck","HealthCheck","TeamCheck","WorldFOVEnabled",
    "RageMode","SilentAim","ShowSilentFOV","RollMacro","WeaponSpamMacro",
    "ESPEnabled","ShowBox","ShowName","ShowHealth","ShowDistance","ShowSkeleton",
}
local PERSIST_NUM = {
    "MaxDistance","WorldFOV","AimStrength","AimSensitivity",
    "SmoothStrength","AimFOV","AimMaxDistance",
    "SilentFOV","SilentHitChance","SilentMaxDistance",
    "RollSpaceDelay","RollRepeatDelay","WeaponSpamDelay",
}
local PERSIST_COLOR = { "BoxColor","NameColor","WhitelistColor","LockedColor","SkeletonColor" }

local function colorToTbl(c) return { r=math.round(c.R*255), g=math.round(c.G*255), b=math.round(c.B*255) } end
local function tblToColor(t) return Color3.fromRGB(tonumber(t.r) or 255, tonumber(t.g) or 255, tonumber(t.b) or 255) end

local function boneTableToList(tbl)
    local out = {}; for k,v in pairs(tbl) do if v then table.insert(out,k) end end; return out
end
local function listToBoneTable(list)
    local out = {}; if type(list)=="table" then for _,v in ipairs(list) do out[v]=true end end; return out
end

local function buildConfigData()
    local d = { Version=3 }
    for _, k in ipairs(PERSIST_BOOL)  do d[k]=Settings[k] end
    for _, k in ipairs(PERSIST_NUM)   do d[k]=Settings[k] end
    for _, k in ipairs(PERSIST_COLOR) do d[k]=colorToTbl(Settings[k]) end
    d.AimBones    = boneTableToList(Settings.AimBones)
    d.SilentBones = boneTableToList(Settings.SilentBones)
    d.AimKeyName  = Settings.AimKeyName
    d.AutoFarmLootKey        = Settings.AutoFarmLootKey
    d.AutoFarmToggleKeyName  = Settings.AutoFarmToggleKeyName
    d.MenuKeyName = Settings.MenuKeyName
    d.RollMacroKeyName         = Settings.RollMacroKeyName
    d.RollWeaponBindName       = Settings.RollWeaponBindName
    d.WeaponSpamTriggerKeyName = Settings.WeaponSpamTriggerKeyName
    d.WeaponSpamBindName       = Settings.WeaponSpamBindName
    d.Whitelist = {}
    for n in pairs(Whitelist) do table.insert(d.Whitelist, n) end
    return d
end

local function applyConfigData(d)
    if type(d) ~= "table" then return false end
    for _, k in ipairs(PERSIST_BOOL)  do if type(d[k])=="boolean" then Settings[k]=d[k] end end
    for _, k in ipairs(PERSIST_NUM)   do if type(d[k])=="number"  then Settings[k]=d[k] end end
    for _, k in ipairs(PERSIST_COLOR) do if type(d[k])=="table"   then Settings[k]=tblToColor(d[k]) end end
    if type(d.AimBones)    == "table" then Settings.AimBones    = listToBoneTable(d.AimBones) end
    if type(d.SilentBones) == "table" then Settings.SilentBones = listToBoneTable(d.SilentBones) end
    if AIM_KEYS[d.AimKeyName]   then Settings.AimKeyName  = d.AimKeyName end
    if WEAPON_BIND_KEYS[d.AutoFarmLootKey]        then Settings.AutoFarmLootKey        = d.AutoFarmLootKey        end
    if ROLL_MACRO_KEYS[d.AutoFarmToggleKeyName]   then Settings.AutoFarmToggleKeyName  = d.AutoFarmToggleKeyName  end
    if MENU_KEYS[d.MenuKeyName] then Settings.MenuKeyName = d.MenuKeyName end
    if ROLL_MACRO_KEYS[d.RollMacroKeyName] ~= nil or d.RollMacroKeyName=="None" then Settings.RollMacroKeyName=d.RollMacroKeyName end
    if WEAPON_BIND_KEYS[d.RollWeaponBindName] ~= nil or d.RollWeaponBindName=="None" then Settings.RollWeaponBindName=d.RollWeaponBindName end
    if WEAPON_BIND_KEYS[d.WeaponSpamTriggerKeyName] ~= nil or d.WeaponSpamTriggerKeyName=="None" then Settings.WeaponSpamTriggerKeyName=d.WeaponSpamTriggerKeyName end
    if WEAPON_BIND_KEYS[d.WeaponSpamBindName] ~= nil or d.WeaponSpamBindName=="None" then Settings.WeaponSpamBindName=d.WeaponSpamBindName end
    if type(d.Whitelist)=="table" then
        Whitelist={}
        for _, n in ipairs(d.Whitelist) do if type(n)=="string" then Whitelist[n]=true end end
    end
    return true
end

local function syncUI()
    for flag, el in pairs(Window.Flags) do
        if Settings[flag] ~= nil then pcall(function() el:Set(Settings[flag]) end) end
    end
end

local function ensureFolder()
    if HAS_FS and not isfolder(CFG_FOLDER) then makefolder(CFG_FOLDER) end
end

local function listConfigs()
    if not HAS_FS then return {} end
    ensureFolder()
    local ok, files = pcall(listfiles, CFG_FOLDER)
    if not ok then return {} end
    local names = {}
    for _, f in ipairs(files) do
        local name = f:match("([^/\\]+)%.json$")
        if name and name:sub(1,1) ~= "_" then table.insert(names, name) end
    end
    table.sort(names); return names
end

local function cfgExists(n) return HAS_FS and isfile(cfgPath(n)) end

local function saveConfig(n)
    if not HAS_FS then return false,"No file functions." end
    ensureFolder()
    return pcall(function() writefile(cfgPath(n), HttpService:JSONEncode(buildConfigData())) end)
end

local function loadConfig(n)
    if not HAS_FS then return false,"No file functions." end
    if not cfgExists(n) then return false,"File not found." end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(cfgPath(n))) end)
    if not ok or type(data)~="table" then return false,"Corrupted." end
    if not applyConfigData(data) then return false,"Apply error." end
    -- Old config files may not have AimEnabled / ESPEnabled saved (they were
    -- added to PERSIST_BOOL later). If the key is absent from the file,
    -- applyConfigData leaves Settings at whatever the current value is.
    -- But if an old file explicitly saved false (e.g. from a bugged session),
    -- we correct that here by treating a missing key as "true" for these two.
    if data.AimEnabled == nil  then Settings.AimEnabled  = true end
    if data.ESPEnabled == nil  then Settings.ESPEnabled  = true end
    syncUI()
    -- Re-apply keybinds so macros match the loaded settings
    pcall(rebindRollMacro)
    pcall(rebindWeaponSpamTrigger)
    pcall(rebindAutofarmToggle)
    -- ── Explicit side-effect re-application ──────────────────────────────────
    -- syncUI updates visuals but Toggle callbacks are NOT re-fired by :Set().
    -- This means ESPEnabled / AimEnabled etc. were written to Settings by
    -- applyConfigData, but nothing actually *activated* them. We re-apply here
    -- so ESP shows immediately and aim is live without the user having to
    -- manually toggle each setting off and on again.
    --
    -- Autofarm is intentionally NOT re-started on config load — the warning in
    -- the UI says to set a keybind first, and auto-starting it on load could
    -- trap the user if they load a Rage config in a PVP lobby.
    if Settings.WorldFOVEnabled then
        pcall(function() Camera.FieldOfView = Settings.WorldFOV end)
    end
    if Settings.WeaponSpamMacro then
        pcall(startWeaponSpam)
    else
        pcall(stopWeaponSpam)
    end
    -- Force ESP and Aim to actually activate — syncUI/:Set() updates the
    -- toggle visuals but does NOT fire callbacks, so we re-apply here.
    -- Without this, loading a config with ESPEnabled=true shows the toggle
    -- as ON in the UI but ESP stays invisible until the user manually flips it.
    task.spawn(function()
        task.wait() -- one frame so render loop catches the new Settings
        if not Settings.ESPEnabled then
            for _, obj in pairs(ESPObjects) do pcall(hideESP, obj) end
        end
        -- Aim: nothing extra needed; AimEnabled is read per-frame from Settings.
        -- FOV circle visibility is handled in renderBody already.
    end)
    return true,"OK"
end

local function deleteConfig(n)
    if not cfgExists(n) then return false end
    return (pcall(function() delfile(cfgPath(n)) end))
end

local function getAutoload()
    if not (HAS_FS and isfile(AUTOLOAD_FILE)) then return nil end
    local ok, s = pcall(readfile, AUTOLOAD_FILE)
    if not ok then return nil end
    s = s:gsub("%s+",""); return s ~= "" and s or nil
end

local function setAutoload(n)
    if not HAS_FS then return false end
    ensureFolder()
    if n then return (pcall(writefile, AUTOLOAD_FILE, n)) end
    if isfile(AUTOLOAD_FILE) then return (pcall(delfile, AUTOLOAD_FILE)) end
    return true
end

local B64CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
local B64MAP = {}
for i=1,#B64CHARS do B64MAP[B64CHARS:sub(i,i)]=i-1 end
local CODE_PREFIX = "KISAME3"

local function b64enc(data)
    local out = {}
    for i=1,#data,3 do
        local a,b,c = data:byte(i,i+2)
        local n = a*65536+(b or 0)*256+(c or 0)
        out[#out+1]=B64CHARS:sub(math.floor(n/262144)%64+1,math.floor(n/262144)%64+1)
        out[#out+1]=B64CHARS:sub(math.floor(n/4096)%64+1,math.floor(n/4096)%64+1)
        if b then out[#out+1]=B64CHARS:sub(math.floor(n/64)%64+1,math.floor(n/64)%64+1) end
        if c then out[#out+1]=B64CHARS:sub(n%64+1,n%64+1) end
    end
    return table.concat(out)
end
local function b64dec(str)
    local out = {}
    for i=1,#str,4 do
        local chunk=str:sub(i,i+3); local v={}
        for j=1,#chunk do local x=B64MAP[chunk:sub(j,j)]; if x==nil then return nil end; v[j]=x end
        if #v<2 then return nil end
        local n=v[1]*262144+v[2]*4096+(v[3] or 0)*64+(v[4] or 0)
        out[#out+1]=string.char(math.floor(n/65536)%256)
        if #v>=3 then out[#out+1]=string.char(math.floor(n/256)%256) end
        if #v>=4 then out[#out+1]=string.char(n%256) end
    end
    return table.concat(out)
end
local function checksum(str)
    local h=5381
    for i=1,#str do h=(h*33+str:byte(i))%4294967296 end
    return string.format("%08x",h)
end

local SHARE_BOOL = {
    "AimEnabled","AimSmoothing","StickyAim","RageMode",
    "VisibleCheck","HealthCheck","TeamCheck","SilentAim",
    "ShowFOVCircle","ShowSilentFOV",
    "ESPEnabled","ShowBox","ShowName","ShowHealth","ShowDistance","ShowSkeleton","AutoFarmEnabled",
    "WorldFOVEnabled",
}
local SHARE_NUM = {
    "AimStrength","AimSensitivity","SmoothStrength",
    "AimFOV","AimMaxDistance","SilentFOV","SilentHitChance","SilentMaxDistance",
    "MaxDistance","WorldFOV",
}
local SHARE_COLOR = { "BoxColor","NameColor","WhitelistColor","LockedColor" }
local SHARE_STR_LISTS = { "AimBones","SilentBones" }
local SHARE_KEYS = { "AimKeyName","MenuKeyName" }

local function buildShareData()
    local d = { Version=3 }
    for _, k in ipairs(SHARE_BOOL)  do d[k]=Settings[k] end
    for _, k in ipairs(SHARE_NUM)   do d[k]=Settings[k] end
    for _, k in ipairs(SHARE_COLOR) do d[k]=colorToTbl(Settings[k]) end
    for _, k in ipairs(SHARE_STR_LISTS) do d[k]=boneTableToList(Settings[k]) end
    for _, k in ipairs(SHARE_KEYS)  do d[k]=Settings[k] end
    return d
end
local function applyShareData(d)
    if type(d)~="table" then return false end
    for _, k in ipairs(SHARE_BOOL)  do if type(d[k])=="boolean" then Settings[k]=d[k] end end
    for _, k in ipairs(SHARE_NUM)   do if type(d[k])=="number"  then Settings[k]=d[k] end end
    for _, k in ipairs(SHARE_COLOR) do if type(d[k])=="table"   then Settings[k]=tblToColor(d[k]) end end
    for _, k in ipairs(SHARE_STR_LISTS) do if type(d[k])=="table" then Settings[k]=listToBoneTable(d[k]) end end
    for _, k in ipairs(SHARE_KEYS)  do if type(d[k])=="string" and AIM_KEYS[d[k]] or MENU_KEYS[d[k]] or d[k]=="None" then Settings[k]=d[k] end end
    return true
end
local function encodeShareCode(data)
    local json = HttpService:JSONEncode(data)
    return CODE_PREFIX..":"..b64enc(json)..":"..checksum(json)
end
local function decodeShareCode(code)
    code = tostring(code or ""):gsub("%s+","")
    if code=="" then return nil,"Paste a share code first." end
    if #code>20000 then return nil,"Code too long." end
    local b64,sum = code:match("^"..CODE_PREFIX..":([%w%-_]+):(%x+)$")
    if not b64 then return nil,"Invalid code." end
    local json = b64dec(b64)
    if not json or checksum(json)~=sum:lower() then return nil,"Corrupted code." end
    local ok,d = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(d)~="table" then return nil,"Corrupted." end
    return d
end
local function copyToClipboard(text)
    local _syn = rawget and rawget(_G,"syn")
    local fn = setclipboard or toclipboard or (_syn and _syn.write_clipboard)
    if fn then return pcall(fn,text) end; return false
end

local function notify(title,msg,dur) Window:Notify(title,msg,dur) end
local function cleanName(n)
    n=tostring(n or ""):gsub("^%s+",""):gsub("%s+$",""):gsub("[^%w_%-]","_"); return n
end

local pending = {}
local function confirm(key,msg)
    local now=os.clock()
    if pending[key] and now-pending[key]<5 then pending[key]=nil; return true end
    pending[key]=now; notify("Are you sure?",msg.." Press again within 5s.",4); return false
end

local selectedCfg, newCfgName = nil, ""
local cfgDropdown, autoLabel
local importCodeText = ""

_preSaveFn = function()
    if not HAS_FS then return end
    ensureFolder()
    -- Only save if the user had an explicitly named non-preset config loaded
    if not selectedCfg or selectedCfg == "" then return end
    pcall(function() writefile(cfgPath(selectedCfg), HttpService:JSONEncode(buildConfigData())) end)
    pcall(function() writefile(AUTOLOAD_FILE, selectedCfg) end)
end

local function updateAutoLabel()
    autoLabel:Set("Auto-load: "..(getAutoload() or "off"))
end

local function refreshCfgList(pick)
    local list = listConfigs()
    if pick and not table.find(list, pick) then pick=nil end
    if not pick and selectedCfg and table.find(list, selectedCfg) then pick=selectedCfg end
    pick = pick or list[1]
    cfgDropdown:Refresh(list)
    cfgDropdown:Set(pick)
end

if not HAS_FS then ConfigTab:Label("No file functions - configs unavailable.") end

