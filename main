    local data,err=decodeShareCode(importCodeText)
    if not data then return notify("Failed",tostring(err),4) end
    if not applyShareData(data) then return notify("Failed","Format error.",4) end
    syncUI()
    local name=cleanName(newCfgName)
    if name~="" and HAS_FS then
        if cfgExists(name) then notify("Imported",'"'..name..'" exists - applied only.',5)
